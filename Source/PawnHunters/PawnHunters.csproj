<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>none</AnalysisLevel>
		<Configurations>Debug</Configurations>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
		<DebugType>none</DebugType>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<EnableNETAnalyzers>False</EnableNETAnalyzers>
		<NoWarn>CS8603,CS0649,CS8618</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- Must match the game build in RimWorld/Version.txt; bump after game updates. -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="KCSG">
			<HintPath>e:\SteamLibrary\steamapps\workshop\content\294100\2023507013\1.7\Assemblies\KCSG.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
